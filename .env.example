# Skopiuj do .env na serwerze: cp .env.example .env

# Hasło do panelu /admin
ADMIN_PASSWORD=zmien-mnie

# Min. 32 znaki. Szyfruje pary w bazie i podpisuje sesję admina.
# Wygeneruj: openssl rand -base64 48
# UWAGA: zmiana po utworzeniu losowań = istniejące pary nie do odczytania.
APP_SECRET=

# Domena (bez https://). PUBLIC_URL ustawia się z niej automatycznie w docker-compose.yml.
DOMAIN=losowanie.toadres.pl

# Tylko dla subdomeny Mikrusa (HTTPS robi Mikrus, do serwera idzie zwykłe HTTP na port 80).
# Dla własnej domeny z DNS na ten serwer — usuń tę linię, Caddy sam zrobi certyfikat.
CADDY_SITE=http://losowanie.toadres.pl
