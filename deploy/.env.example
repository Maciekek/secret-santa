# ---- deploy/.env : skopiuj do .env obok docker-compose.yml i uzupełnij ----

# Subdomena Mikrusa (bez https://). PUBLIC_URL ustawia się z niej automatycznie.
DOMAIN=swieta.toadres.pl

# Port na hoście — ten sam wpisz w panelu Mikrusa przy subdomenie (checkbox „HTTPS” odznaczony).
HOST_PORT=3005

# Hasło do panelu /admin
ADMIN_PASSWORD=

# Min. 32 znaki. Szyfruje pary w bazie i podpisuje sesję admina.
# Wygeneruj: openssl rand -base64 48
# UWAGA: zmiana po utworzeniu losowań = istniejące pary nie do odczytania.
APP_SECRET=

# Opcjonalnie: tag obrazu (latest, sha commita albo wersja np. 1.0.0)
SECRET_SANTA_TAG=latest

# Opcjonalnie: powiadomienia push na telefon (aplikacja ntfy, Android/iOS).
# Kliknięcie powiadomienia otwiera WhatsApp z gotową wiadomością dla rodziny.
# Temat = „hasło” — wymyśl długi i trudny do zgadnięcia, np. gwiazdka-<losowe-znaki>.
# NTFY_TOPIC=
# Co zgłaszać (po przecinku): listy (nowy list do Mikołaja), lista (ktoś dopisał, co przyniesie), losowanie
# NTFY_EVENTS=listy
